APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=enterprise_ai
REDIS_URL=redis://redis:6379/0
AZURE_BLOB_ENDPOINT=http://azurite:10000/devstoreaccount1
AZURE_BLOB_CONTAINER=documents
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=local-development-secret-change-me
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=86400
PINECONE_API_KEY=
OPENAI_API_KEY=


# Authentication defaults (local HTTP only; hosted environments require HTTPS).
COOKIE_SECURE=false
JWT_ISSUER=enterprise-ai-assistant
JWT_AUDIENCE=enterprise-ai-assistant-api
PASSWORD_MIN_LENGTH=15
LOGIN_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=900
REFRESH_RATE_LIMIT=30
REFRESH_RATE_WINDOW_SECONDS=60
COOKIE_IP_RATE_LIMIT=120
LOGOUT_ALL_RATE_LIMIT=5
LOGOUT_ALL_RATE_WINDOW_SECONDS=900
MAX_REFRESH_ROTATIONS=2048
AUTH_RATE_PREFIX=enterprise_ai:auth:

# Admin management: database transactions require a replica set (local rs0).
ADMIN_WRITE_RATE_LIMIT=30
ADMIN_READ_RATE_LIMIT=120
ADMIN_TRANSACTION_TIMEOUT_SECONDS=15
